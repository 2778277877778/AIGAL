################################################################################
## T6 四月「光」—— 运动会、八百米、音乐社成立
##
## 固定拍三个 + 自由行动。club（音乐社成立）由脚本置位。
## 报名那一拍给三个选项：join / help / no，只影响台词与后文细节。
################################################################################

image bg music_room = Solid("#20241f")

default t6_join = ""   # join / help / no

label t6_april:

    $ start_month(6)

    ## 月初 · 运动会报名
    scene bg classroom_day
    "四月。运动会报名表传到我手里的时候，八百米那栏已经写着我的名字。"
    inner "（周子博的字。他连「本人签字」都替我画好了。）"

    ## 夏 M2（第一场训练）——并进主拍的事实清单
    ## 主拍 · 音乐社成立（开幕式她弹琴、八百米摔终点、训练结束并进这一拍）
    $ set_flag("club")
    scene bg music_room
    call ai_play("t6_club", "", "运动会开幕式缺钢琴，她的名字被报上去，她弹了，散场有人夸「学委还有这手艺」；八百米他最后一个跑完、摔在终点，她递水说「你跑得很慢，但你跑完了」；另一次训练结束，她跑完最后一圈说「没事」，把手里的水递过来；音乐社成立，她当社长，他第一个报名。")
    $ mark_milestone_for_beat("t6_club")
    $ mark_milestone("xia", 2)
    menu:
        "第一个在报名表上签字。":
            $ t6_join = "join"
        "只帮忙搬椅子，不签字。":
            $ t6_join = "help"
        "不参加。":
            $ t6_join = "no"
    if t6_join == "join":
        "报名表上我把名字写在第一行。写完才发现，手心里全是汗。"
    elif t6_join == "no":
        "我没报名。回教室的路上，周子博问我为什么不报，我说没时间。"
    else:
        "我帮着搬了两趟椅子，没在表上签字。"

    ## 随机事件槽（60% 命中，抽不中就是纯自由行动）
    call event_slot

    ## 自由行动
    call free_actions

    ## 月末结算
    scene bg dorm_402
    "【T6 月末结算 · 学习 [study]，压力 [stress]，体力 [stamina]，钱 [money]。】"
    "【本月结束。】"

    jump t7_may
